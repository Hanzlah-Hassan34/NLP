# DentaBot Evaluation Environment Variables
# Copy this to .env and fill in your keys

# Google Gemini API Key (FREE - recommended for RAGAS/DeepEval)
# Get it at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-gemini-api-key

# OpenAI API Key (alternative, requires payment)
OPENAI_API_KEY=sk-your-openai-api-key

# LangSmith API Key (required for LangSmith tracing)
LANGCHAIN_API_KEY=ls__your-langsmith-api-key
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=dentabot-eval
